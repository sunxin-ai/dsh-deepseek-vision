# 安装产物
/node_modules
/eval/node_modules
*.tgz

# 本体补丁的原文备份（只应留在 DSH 那边，不该出现在本仓库）。
# 两个后缀都挡：install.mjs 写 ORIG_SUFFIX，还原时另认 LEGACY_ORIG_SUFFIXES。
*.dsh-design-qa-orig
*.dsh-vision-orig

# 环境文件可能含密钥 —— 绝不入库。带后缀的一并排除（.env.bailian 这类）
/.env
/.env.*

# eval 的可再生产物。注意 /eval/runs/ 不在此列 —— 那是 README 结论的原始模型输出，
# 有意入库，别用更宽的通配把它一起挡掉。
/eval/**/crops/
/eval/**/results*/
/eval/**/pairs/
/eval/**/tiles/
/eval/**/composite/
/eval/**/.playwright/

.DS_Store
