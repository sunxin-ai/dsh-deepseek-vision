{
  "name": "dsh-design-qa",
  "version": "0.1.3",
  "description": "让 DeepSeek Harness 里任何纯文本模型都能读图。识图是按需调用的 tool —— 图片不进主模型上下文，不看就不花钱；附 23 处缺陷的评测集，换模型可自测。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "vision",
    "design-qa",
    "visual-regression",
    "design-review",
    "multimodal",
    "qwen-vl",
    "openai-compatible"
  ],
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "src",
    "skills",
    "patches",
    "cordis.patch.yml",
    "install.mjs",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "tsdown --entry src/index.ts --format esm --out-dir lib --dts false --no-config",
    "install-plugin": "node install.mjs",
    "restart": "node install.mjs --restart"
  },
  "author": "sunxin-ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunxin-ai/dsh-design-qa.git"
  },
  "bugs": {
    "url": "https://github.com/sunxin-ai/dsh-design-qa/issues"
  },
  "homepage": "https://github.com/sunxin-ai/dsh-design-qa#readme",
  "main": "./lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "tsdown": "0.15.12"
  }
}
